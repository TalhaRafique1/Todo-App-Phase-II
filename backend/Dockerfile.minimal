FROM python:3.11-slim

WORKDIR /app

# Copy only the main.py file and its direct dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir fastapi uvicorn

# Create a minimal main.py with the essential functionality
RUN mkdir -p src
RUN echo 'from fastapi import FastAPI\n\napp = FastAPI()\n\n@app.get("/")\ndef read_root():\n    return {"Hello": "World"}\n\n@app.get("/health")\ndef health_check():\n    return {"status": "healthy"}' > src/main.py

EXPOSE 8000

CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]